# Verifies a SQLite snapshot: presence, checksum, gzip integrity, and DB integrity.
# Usage: l9-sqlite-verify <path-to-latest.sqlite.gz>
set -euo pipefail
file=${1:?backup file required}
test -s "$file"
sha256sum --check "$file.sha256"
gzip -t "$file"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
gzip -dc "$file" > "$tmp"
test "$(sqlite3 "$tmp" 'PRAGMA integrity_check;')" = "ok"
echo "PASS"
