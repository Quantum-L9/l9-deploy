#!/usr/bin/env bash
# --- L9_META ---
# l9_schema: 1
# origin: l9-deployment-platform
# layer:
# - repository
# tags:
# - L9_META
# - deployment-platform
# owner: platform
# status: active
# --- /L9_META ---
# Consistent online snapshot of the canonical SQLite active-memory store.
# Usage: l9-sqlite-backup <project> <environment> <request_id>
set -euo pipefail
project=${1:?project required}
environment=${2:?environment required}
request_id=${3:?request id required}
db=${L9_MEMORY_DB_PATH:-/var/lib/l9-memory/memory.db}
dest="/srv/l9/backups/${project}/${environment}"
test -f "$db"
mkdir -p "$dest"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
sqlite3 "$db" ".backup '$tmp'"
gzip -c "$tmp" > "$dest/latest.sqlite.gz"
sha256sum "$dest/latest.sqlite.gz" > "$dest/latest.sqlite.gz.sha256"
echo "sqlite backup written: $dest/latest.sqlite.gz (request ${request_id})"
