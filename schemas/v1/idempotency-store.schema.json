{
  "x-l9-meta": {
    "l9_schema": 1,
    "origin": "l9-deployment-platform",
    "layer": [
      "contracts",
      "state"
    ],
    "tags": [
      "L9_META",
      "deployment-platform",
      "idempotency"
    ],
    "owner": "platform",
    "status": "active"
  },
  "$id": "https://schemas.quantum-l9.invalid/l9/idempotency-store/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "L9 Deployment Idempotency Store",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "l9.idempotency-store/v1"
    },
    "entries": {
      "type": "object",
      "propertyNames": {
        "minLength": 1,
        "maxLength": 200
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "IN_PROGRESS",
              "PREPARED",
              "COMPLETE",
              "FAIL"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "receipt_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "request_digest",
          "status",
          "updated_at"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "IN_PROGRESS"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "receipt_digest": {
                  "type": "null"
                },
                "reason": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "PREPARED",
                    "COMPLETE"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "receipt_digest"
              ],
              "properties": {
                "receipt_digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "reason": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "FAIL"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "receipt_digest": {
                  "type": "null"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "entries"
  ]
}
