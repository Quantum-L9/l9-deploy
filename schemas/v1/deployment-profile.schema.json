{
  "x-l9-meta": {
    "l9_schema": 1,
    "origin": "l9-deployment-platform",
    "layer": [
      "repository"
    ],
    "tags": [
      "L9_META",
      "deployment-platform"
    ],
    "owner": "platform",
    "status": "active"
  },
  "$id": "https://schemas.quantum-l9.invalid/l9/deployment-profile/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "project": {
            "properties": {
              "runtime_profile": {
                "const": "stateful-container"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "backup",
          "storage",
          "services"
        ]
      }
    }
  ],
  "properties": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "pattern": "^ghcr\\.io/[a-z0-9._-]+/[a-z0-9._/-]+$",
          "type": "string"
        },
        "registry": {
          "const": "ghcr.io"
        },
        "require_digest": {
          "const": true
        },
        "require_provenance_attestation": {
          "type": "boolean"
        },
        "require_sbom_attestation": {
          "type": "boolean"
        }
      },
      "required": [
        "registry",
        "image",
        "require_digest",
        "require_provenance_attestation",
        "require_sbom_attestation"
      ],
      "type": "object"
    },
    "backup": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "restore_test_command": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "timeout_seconds": {
          "maximum": 7200,
          "minimum": 1,
          "type": "integer"
        },
        "verify_command": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "command",
        "verify_command",
        "restore_test_command",
        "timeout_seconds"
      ],
      "type": "object"
    },
    "health": {
      "additionalProperties": false,
      "properties": {
        "post_deploy": {
          "$ref": "https://schemas.quantum-l9.invalid/l9/health-probe/v1"
        },
        "startup": {
          "$ref": "https://schemas.quantum-l9.invalid/l9/health-probe/v1"
        }
      },
      "required": [
        "startup",
        "post_deploy"
      ],
      "type": "object"
    },
    "migrations": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "command",
              "mode",
              "use_release_image",
              "timeout_seconds"
            ]
          }
        }
      ],
      "properties": {
        "backup_required": {
          "type": "boolean"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "pre_start",
            "post_start",
            "manual"
          ]
        },
        "rollback_safe": {
          "default": false,
          "type": "boolean"
        },
        "timeout_seconds": {
          "maximum": 3600,
          "minimum": 1,
          "type": "integer"
        },
        "use_release_image": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "backup_required"
      ],
      "type": "object"
    },
    "network": {
      "additionalProperties": false,
      "properties": {
        "private_dependencies_only": {
          "type": "boolean"
        },
        "public_ingress": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "hostnames": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "tls": {
              "enum": [
                "automatic",
                "external",
                "disabled"
              ]
            }
          },
          "required": [
            "enabled"
          ],
          "type": "object"
        }
      },
      "required": [
        "public_ingress",
        "private_dependencies_only"
      ],
      "type": "object"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "allowed_source_refs": {
          "additionalProperties": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "type": "object"
        },
        "require_clean_ci_gate": {
          "type": "boolean"
        },
        "require_profile_digest_match": {
          "type": "boolean"
        }
      },
      "required": [
        "allowed_source_refs",
        "require_clean_ci_gate",
        "require_profile_digest_match"
      ],
      "type": "object"
    },
    "project": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{1,63}$",
          "type": "string"
        },
        "owner_team": {
          "minLength": 1,
          "type": "string"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "runtime_profile": {
          "enum": [
            "container-service",
            "worker-service",
            "stateful-container",
            "scheduled-job",
            "external-platform"
          ]
        }
      },
      "required": [
        "id",
        "repository",
        "owner_team",
        "runtime_profile"
      ],
      "type": "object"
    },
    "release": {
      "additionalProperties": false,
      "properties": {
        "automatic_rollback": {
          "type": "boolean"
        },
        "production_approval_required": {
          "type": "boolean"
        },
        "retain_successful_releases": {
          "maximum": 50,
          "minimum": 2,
          "type": "integer"
        },
        "stabilization_seconds": {
          "default": 30,
          "maximum": 900,
          "minimum": 0,
          "type": "integer"
        },
        "strategy": {
          "enum": [
            "rolling-single-host",
            "blue-green-single-host",
            "replace"
          ]
        }
      },
      "required": [
        "strategy",
        "retain_successful_releases",
        "automatic_rollback",
        "production_approval_required"
      ],
      "type": "object"
    },
    "runtime": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "enum": [
            "linux/amd64",
            "linux/arm64"
          ]
        },
        "command": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "container_port": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "read_only_root_filesystem": {
          "default": false,
          "type": "boolean"
        },
        "stop_grace_seconds": {
          "maximum": 300,
          "minimum": 1,
          "type": "integer"
        },
        "user": {
          "enum": [
            "non_root",
            "image_defined"
          ]
        },
        "volumes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "read_only": {
                "type": "boolean"
              },
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "target"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "architecture",
        "user",
        "stop_grace_seconds"
      ],
      "type": "object"
    },
    "schema": {
      "const": "l9.deployment-profile/v1"
    },
    "secrets": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "infisical"
        },
        "environment_mapping": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "type": "object"
        },
        "project_slug": {
          "minLength": 1,
          "type": "string"
        },
        "runtime_mode": {
          "enum": [
            "runtime_fetch",
            "deploy_render"
          ]
        }
      },
      "required": [
        "authority",
        "runtime_mode",
        "project_slug",
        "environment_mapping"
      ],
      "type": "object"
    },
    "services": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              "managed_on_fleet",
              "external",
              "none"
            ]
          },
          "probe": {
            "$ref": "https://schemas.quantum-l9.invalid/l9/health-probe/v1"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "mode",
          "required"
        ],
        "type": "object"
      },
      "type": "object"
    },
    "storage": {
      "additionalProperties": false,
      "properties": {
        "persistent_volumes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "backup_policy": {
                "enum": [
                  "none",
                  "daily",
                  "weekly",
                  "before_deploy"
                ]
              },
              "mount_path": {
                "pattern": "^/",
                "type": "string"
              },
              "name": {
                "pattern": "^[a-z][a-z0-9-]{1,63}$",
                "type": "string"
              }
            },
            "required": [
              "name",
              "mount_path",
              "backup_policy"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "schema",
    "project",
    "artifact",
    "runtime",
    "health",
    "release",
    "migrations",
    "secrets",
    "network",
    "policy"
  ],
  "title": "L9 Deployment Profile",
  "type": "object"
}
