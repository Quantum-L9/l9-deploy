{
  "x-l9-meta": {
    "l9_schema": 1,
    "origin": "l9-deployment-platform",
    "layer": [
      "repository"
    ],
    "tags": [
      "L9_META",
      "deployment-platform"
    ],
    "owner": "platform",
    "status": "active"
  },
  "$id": "https://schemas.quantum-l9.invalid/l9/host-conformance/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checked_at": {
      "format": "date-time",
      "type": "string"
    },
    "checks": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "l9.host-conformance/v1"
    },
    "server_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "PASS_WITH_FINDINGS",
        "BLOCKED",
        "FAIL",
        "UNKNOWN"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema",
    "server_id",
    "checked_at",
    "status",
    "checks",
    "digest"
  ],
  "title": "Host Conformance",
  "type": "object"
}
