# Placeholder names ONLY. Copy to .env, fill from your vault, never commit real values.
# Operator bootstrap (Phase 1-3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
L9_STATE_BUCKET=
L9_STATE_ENDPOINT=
L9_STATE_REGION=eu-central
INFISICAL_IDENTITY_ID=
INFISICAL_PROJECT_SLUG=

# OpenTofu vars (also settable via Infisical as TF_VAR_*)
TF_VAR_hcloud_token=
TF_VAR_ssh_key_ids=          # JSON list, e.g. [12345678]
TF_VAR_network_id=           # staging/prod only, from management output
TF_VAR_servers=              # staging/prod only, HCL/JSON map; private_ip must match fleet/registry.yaml

# Active-memory (graphiti-memory)
L9_REDIS_ACL_PASSWORD=
L9_MEMORY_DEPLOYMENT_ID=
L9_MEMORY_TRUST_DOMAIN=
L9_MEMORY_HTTP_AUTH_TOKEN=

# Runner (Phase 3, pass via -e; do not persist)
L9_RUNNER_REGISTRATION_TOKEN=
L9_RUNNER_SHA256=
